<Ui xmlns="http://www.blizzard.com/wow/ui/" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://www.blizzard.com/wow/ui/
..\FrameXML\UI.xsd">

	<!-- column header; width and text alignment are set in AddonUsage.lua -->
	<Button name="AddonUsageHeaderTemplate" virtual="true">
		<Size x="0" y="19"/>
		<Layers>
			<Layer level="ARTWORK">
				<Texture name="$parentLeft" file="Interface\FriendsFrame\WhoFrame-ColumnTabs">
					<Size x="5" y="19"/>
					<Anchors>
						<Anchor point="TOPLEFT"/>
					</Anchors>
					<TexCoords left="0" right="0.078125" top="0" bottom="0.59375"/>
				</Texture>
				<Texture name="$parentRight" file="Interface\FriendsFrame\WhoFrame-ColumnTabs">
					<Size x="4" y="19"/>
					<Anchors>
						<Anchor point="TOPRIGHT"/>
					</Anchors>
					<TexCoords left="0.90625" right="0.96875" top="0" bottom="0.59375"/>
				</Texture>
				<Texture file="Interface\FriendsFrame\WhoFrame-ColumnTabs">
					<Size x="10" y="19"/>
					<Anchors>
						<Anchor point="LEFT" relativeTo="$parentLeft" relativePoint="RIGHT"/>
						<Anchor point="RIGHT" relativeTo="$parentRight" relativePoint="LEFT"/>
					</Anchors>
					<TexCoords left="0.078125" right="0.90625" top="0" bottom="0.59375"/>
				</Texture>
			</Layer>
		</Layers>
		<ButtonText name="$parentText">
			<Anchors>
				<Anchor point="CENTER" x="0" y="0"/>
			</Anchors>
		</ButtonText>
		<NormalFont style="GameFontHighlightSmall"/>
		<HighlightTexture file="Interface\PaperDollInfoFrame\UI-Character-Tab-Highlight" alphaMode="ADD">
			<Size x="5" y="24"/>
			<Anchors>
				<Anchor point="LEFT"/>
				<Anchor point="RIGHT" x="4" y="0"/>
			</Anchors>
		</HighlightTexture>
		<Scripts>
			<OnClick>
				AddonUsage.HeaderOnClick(self)
			</OnClick>
		</Scripts>
	</Button>

	<!-- primary frame -->
	<Frame name="AddonUsage" parent="UIParent" toplevel="true" enableMouse="true" movable="true" resizable="true" clampedToScreen="true" frameStrata="HIGH" hidden="true">
		<Size x="380" y="360"/>
		<Anchors>
			<Anchor point="CENTER"/>
		</Anchors>
		<Backdrop bgFile="Interface\DialogFrame\UI-DialogBox-Background" edgeFile="Interface\Tooltips\UI-Tooltip-Border" tile="true">
			<BackgroundInsets>
				<AbsInset left="4" right="4" top="4" bottom="4"/>
			</BackgroundInsets>
			<TileSize>
				<AbsValue val="16"/>
			</TileSize>
			<EdgeSize>
				<AbsValue val="16"/>
			</EdgeSize>
		</Backdrop>
		<Layers>
			<Layer level="ARTWORK">
				<FontString name="$parentTitle" parentKey="title" text="Addon Usage" inherits="GameFontNormal">
					<Anchors>
						<Anchor point="TOP" x="0" y="-10"/>
					</Anchors>
				</FontString>
			</Layer>
		</Layers>

		<Frames>
			<Button name="$parentCloseButton" parentKey="closeButton" inherits="UIPanelCloseButton">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-1" y="-1"/>
				</Anchors>
				<Scripts>
					<OnClick>
						AddonUsage:Hide()
					</OnClick>
				</Scripts>
			</Button>

			<!-- column headers: the name column takes whatever width the memory and cpu columns leave -->
			<Button name="$parentSortCPU" parentKey="sortCPU" inherits="AddonUsageHeaderTemplate" text="CPU (ms/s)" id="3">
				<Anchors>
					<Anchor point="TOPRIGHT" x="-30" y="-30"/>
				</Anchors>
			</Button>
			<Button name="$parentSortMemory" parentKey="sortMemory" inherits="AddonUsageHeaderTemplate" text="Memory (KB)" id="2">
				<Anchors>
					<Anchor point="TOPRIGHT" relativeTo="$parentSortCPU" relativePoint="TOPLEFT"/>
				</Anchors>
			</Button>
			<Button name="$parentSortAddon" parentKey="sortAddon" inherits="AddonUsageHeaderTemplate" text="Addons" id="1">
				<Anchors>
					<Anchor point="TOPLEFT" x="8" y="-30"/>
					<Anchor point="TOPRIGHT" relativeTo="$parentSortMemory" relativePoint="TOPLEFT"/>
				</Anchors>
			</Button>

			<!-- list rows are created in AddonUsage.lua as the window is resized -->
			<ScrollFrame name="$parentScrollFrame" parentKey="scrollFrame" inherits="FauxScrollFrameTemplate">
				<Anchors>
					<Anchor point="TOPLEFT" x="8" y="-50"/>
					<Anchor point="BOTTOMRIGHT" x="-30" y="56"/>
				</Anchors>
				<Scripts>
					<OnVerticalScroll>
						FauxScrollFrame_OnVerticalScroll(self, offset, 16, AddonUsageScrollFrame_Update);
					</OnVerticalScroll>
				</Scripts>
			</ScrollFrame>

			<!-- controls along the bottom of the window -->
			<CheckButton name="$parentProfilingCheckButton" parentKey="profilingCheckButton" inherits="UICheckButtonTemplate">
				<Size x="24" y="24"/>
				<Anchors>
					<Anchor point="BOTTOMLEFT" x="8" y="8"/>
				</Anchors>
				<Scripts>
					<OnClick>
						AddonUsage.CheckOnClick(self)
					</OnClick>
				</Scripts>
			</CheckButton>

			<CheckButton name="$parentAutoCheckButton" parentKey="autoCheckButton" inherits="UICheckButtonTemplate">
				<Size x="24" y="24"/>
				<Anchors>
					<Anchor point="LEFT" relativeTo="$parentProfilingCheckButtonText" relativePoint="RIGHT" x="10" y="0"/>
				</Anchors>
				<Scripts>
					<OnClick>
						AddonUsage.CheckOnClick(self)
					</OnClick>
				</Scripts>
			</CheckButton>

			<Button name="$parentUpdateButton" parentKey="updateButton" text="Update" inherits="UIPanelButtonTemplate">
				<Size x="64" y="22"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-24" y="9"/>
				</Anchors>
				<NormalFont style="GameFontNormalSmall"/>
				<HighlightFont style="GameFontHighlightSmall"/>
				<Scripts>
					<OnClick>
						AddonUsage:Update()
					</OnClick>
				</Scripts>
			</Button>

			<Button name="$parentResetButton" parentKey="resetButton" text="Reset" inherits="UIPanelButtonTemplate">
				<Size x="64" y="22"/>
				<Anchors>
					<Anchor point="RIGHT" relativeTo="$parentUpdateButton" relativePoint="LEFT" x="-2" y="0"/>
				</Anchors>
				<NormalFont style="GameFontNormalSmall"/>
				<HighlightFont style="GameFontHighlightSmall"/>
				<Scripts>
					<OnClick>
						AddonUsage:ResetUsage()
					</OnClick>
				</Scripts>
			</Button>

			<!-- grip in the lower right corner to resize the window -->
			<Button name="$parentResizeGrip" parentKey="resizeGrip">
				<Size x="16" y="16"/>
				<Anchors>
					<Anchor point="BOTTOMRIGHT" x="-4" y="4"/>
				</Anchors>
				<NormalTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Up"/>
				<PushedTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Down"/>
				<HighlightTexture file="Interface\ChatFrame\UI-ChatIM-SizeGrabber-Highlight" alphaMode="ADD"/>
				<Scripts>
					<OnMouseDown>
						AddonUsage:StartSizing("BOTTOMRIGHT")
					</OnMouseDown>
					<OnMouseUp>
						AddonUsage:StopResizing()
					</OnMouseUp>
				</Scripts>
			</Button>
		</Frames>
		<Scripts>
			<OnMouseDown>
				self:StartMoving()
			</OnMouseDown>
			<OnMouseUp>
				self:StopMovingOrSizing()
			</OnMouseUp>
		</Scripts>
	</Frame>

</Ui>
